rules_version = '2';

// 할래말래 Firestore 보안 규칙
// 원칙:
//  1) 익명(비로그인) 쓰기 전면 차단 — 기존 allow-all 최대 구멍(누구나 전 DB 수정·삭제 가능) 제거
//  2) 서버(Cloud Functions/Admin SDK) 전용 컬렉션은 클라이언트 접근 완전 차단
//     (OTP 코드·비번 재설정 로그·시스템 락 노출 차단. Admin SDK는 규칙을 우회하므로 함수는 정상 동작)
//  3) admin_accounts 는 어드민 커스텀 클레임(admin==true) 필요
//  4) 읽기는 기존 동작 유지(비로그인/교차 조회에 의존하는 화면 다수) — 민감 컬렉션만 제한
//  5) 열거되지 않은 컬렉션은 기본 차단(default deny)
// 주의: Firestore 규칙은 여러 match 가 OR 로 합쳐진다 → 넓은 read:true 캐치올을 두면
//       좁은 deny 가 무력화되므로, 잠글 컬렉션을 위해 전 컬렉션을 명시 열거한다.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && request.auth.token.admin == true; }

    // ───── 유저 / 팀 / 매칭 (공개 읽기, 로그인 쓰기) ─────
    // users 쓰기: 본인 문서는 전체 허용. 남의 문서(강퇴·팀장이임·가입수락·경기스탯·RN토큰 저장)는
    // 운영 필드만 허용하고 신원/게이트/금액 필드는 잠근다 — 타인 계정에 phoneVerified·약관동의·
    // isAdmin·피지잔액을 써넣는 위조와 계정 오염을 차단. (정당한 교차쓰기는 아래 보호필드를 안 건드림)
    function usersProtected() {
      return [
        'email', 'phone', 'phoneE164', 'phoneVerified',
        'termsConsent', 'privacyConsent', 'ageOver14Consent', 'welcomeSeen',
        'isAdmin', 'fizzBalance', 'fizzUpdatedAt'
      ];
    }
    // 전화번호 인증 증빙 — verifyPhoneOtp(서버)가 인증 성공 시에만 남긴다.
    // ⚠️ 문서 id 규칙은 functions/otp/phoneOtp.js 의 proofId() 와 반드시 같아야 한다.
    function phoneVerifiedBy(phoneE164) {
      return signedIn() && phoneE164 is string && phoneE164 != ''
        && exists(/databases/$(database)/documents/phone_proofs/$(request.auth.uid + '__' + phoneE164));
    }

    // 어떤 클라이언트도 못 쓰는 필드 — 본인 문서라도 막는다.
    // 어드민 판정은 서버가 발급하는 커스텀 클레임(admin)으로만 하고, users.isAdmin 은 표시용 잔재다.
    // 이걸 안 막으면 자기 문서에 isAdmin:true 한 줄 써서 게이트 면제를 받을 수 있다.
    // (Admin SDK 는 규칙을 우회하므로 서버가 세우는 건 정상 동작)
    function usersServerOnly() { return ['isAdmin']; }

    // phoneVerified 를 false→true 로 올리려면 그 번호를 실제로 인증했다는 서버 증빙이 있어야 한다.
    // (이미 true 인 문서를 그대로 두거나 false 로 내리는 건 자유)
    // 안 막으면 자기 문서에 phoneVerified:true 한 줄 써서 SMS 인증 게이트를 건너뛴다.
    function phoneFlagHonest() {
      return request.resource.data.get('phoneVerified', false) != true
        || resource.data.get('phoneVerified', false) == true
        || phoneVerifiedBy(request.resource.data.get('phoneE164', ''));
    }

    match /users/{id} {
      allow read: if true;
      allow create: if signedIn()
                    && !request.resource.data.keys().hasAny(usersServerOnly())
                    && (request.auth.uid == id
                        || !request.resource.data.keys().hasAny(usersProtected()));
      allow update: if signedIn()
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(usersServerOnly())
                    && phoneFlagHonest()
                    && (request.auth.uid == id
                        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(usersProtected()));
      allow delete: if signedIn() && request.auth.uid == id;
    }
    match /users_by_phone/{id}           { allow read: if true; allow write: if signedIn(); }
    // 전화번호 → 계정 매핑. 여기 primaryUid 가 "이 번호의 주인"이고, 번호 인증을 마친 사람이
    // 그 계정으로 병합된다. 예전엔 로그인만 하면 아무 번호나 쓸 수 있어서, 남의 번호를 미리
    // 선점해 두면 진짜 주인이 인증하는 순간 그 계정이 선점자에게 병합됐다(계정 탈취).
    // → 그 번호를 실제로 인증한 사람만 쓸 수 있게 하고, 주인(primaryUid) 교체는 금지한다.
    match /phones/{phoneE164} {
      allow read: if true;
      allow create: if phoneVerifiedBy(phoneE164)
                    && request.resource.data.primaryUid == request.auth.uid;
      allow update: if phoneVerifiedBy(phoneE164)
                    && request.resource.data.primaryUid == resource.data.primaryUid;
      allow delete: if false;
    }
    // 인증 증빙은 서버(Admin SDK)만 만든다. 클라가 만들 수 있으면 위 검사가 통째로 무의미해진다.
    match /phone_proofs/{id}              { allow read, write: if false; }
    match /clubs/{id}                     { allow read: if true; allow write: if signedIn(); }
    // 팀 로스터(members)·초대(invites)는 공개(팀 프로필/초대 링크). 가입신청(joinRequests)은
    // 지원자 신체정보(키/몸무게·지역)가 playerSnapshot 에 담겨 있어 비로그인 열람을 막는다.
    // (조회 주체는 팀장·어드민뿐 — 모두 로그인 상태라 signedIn() 로 정상 동작)
    match /clubs/{id}/members/{m}         { allow read: if true;       allow write: if signedIn(); }
    match /clubs/{id}/invites/{iv}        { allow read: if true;       allow write: if signedIn(); }
    match /clubs/{id}/joinRequests/{jr}   { allow read: if signedIn();  allow write: if signedIn(); }
    // 그 외 clubs 하위 문서: 공개읽기 캐치올 제거 → 쓰기만 허용(읽기는 위 명시 규칙만 통과)
    match /clubs/{id}/{sub=**}            { allow write: if signedIn(); }
    // 팀 초대: collectionGroup(invites) 조회 지원 (MyTeamInvitesPage)
    match /{path=**}/invites/{inviteId}  { allow read: if signedIn(); allow write: if signedIn(); }
    match /match_requests/{id}            { allow read: if true; allow write: if signedIn(); }
    // 경기 후 상호 리뷰(match_requests/{id}/reviews/{raterUid}) — 서브컬렉션 미열거 시 기본차단됨
    match /match_requests/{id}/{sub=**}   { allow read: if true; allow write: if signedIn(); }
    // 팀원→팀장 매칭 제안 원장(dedup + 성사 통보 대상). 로그인 사용자만 접근.
    match /match_proposals/{id}           { allow read: if signedIn(); allow write: if signedIn(); }
    match /rankings/{id}                  { allow read: if true; allow write: if signedIn(); }
    match /player_sessions/{id}           { allow read: if true; allow write: if signedIn(); }

    // ───── 구장 / 예약 ─────
    // 예약 가능 창구: 오늘 ~ +20일 (src/constants/booking.js BOOKING_WINDOW_DAYS = 21, 오늘 포함 3주).
    // 여기선 기기 시계·타임존 오차 흡수를 위해 하루 여유를 둬 +21일까지 허용한다.
    // (기준 시각은 KST = request.time(UTC) + 9h)
    function kstYmd(plusDays) {
      let t = request.time + duration.value(9, 'h') + duration.value(plusDays, 'd');
      return string(t.year()) + '-'
        + (t.month() < 10 ? '0' : '') + string(t.month()) + '-'
        + (t.day() < 10 ? '0' : '') + string(t.day());
    }
    function inBookingWindow(d) {
      return d is string && d >= kstYmd(0) && d <= kstYmd(21);
    }
    // 구장주 수동·정기대관(최대 52주)은 창구 예외 — venues 문서의 ownerUid 로 실제 소유자만 인정
    function isVenueOwner(venueId) {
      return signedIn() && venueId is string && venueId != ''
        && exists(/databases/$(database)/documents/venues/$(venueId))
        && get(/databases/$(database)/documents/venues/$(venueId)).data.ownerUid == request.auth.uid;
    }
    // 즉시예약 구장인가 — 이 구장만 예약자가 "승인 완료" 상태로 바로 만들 수 있다.
    function venueAutoApprove(venueId) {
      return venueId is string && venueId != ''
        && exists(/databases/$(database)/documents/venues/$(venueId))
        && get(/databases/$(database)/documents/venues/$(venueId)).data.autoApprove == true;
    }

    match /venues/{id}                    { allow read: if true; allow write: if signedIn(); }
    // 구장 리뷰: 본인 명의(uid) 리뷰만 작성/수정 — 타인 사칭·대리작성 차단. (리뷰 문서에 작성자 uid 필수)
    match /venueReviews/{id} {
      allow read: if true;
      allow write: if signedIn() && request.resource.data.uid == request.auth.uid;
    }
    // 결제 흐름(토스) 필드 — 클라이언트는 절대 못 바꾼다. 서버(Admin SDK)만 기록.
    //  (안 잠그면 팀장/예약자가 paid=true 로 찍어 무료 예약을 만들 수 있다)
    // 결제 "결과" — 서버(Cloud Functions)만 기록한다. 클라가 쓰면 결제 없이 확정시킬 수 있다.
    function paymentResultUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'paid', 'paidByA', 'paidByB', 'paymentMethod',
        'paymentKey', 'paymentKeyA', 'paymentKeyB', 'teamAPayerUid', 'teamBPayerUid'
      ]);
    }
    // 결제 마감 시각은 결제 결과가 아니라 "승인 시점"에 찍는 값이다(setReservationStatus).
    // 예전엔 위 서버 전용 목록에 같이 들어 있어서, 구장주가 승인만 눌러도 규칙이 거부했다
    // ("Missing or insufficient permissions") — 승인 자체가 불가능했다.
    function paymentDeadlineUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentDeadline']);
    }
    // 금액 필드 — 구장주/어드민만 조정 가능(요금 정정). 예약자·팀장은 못 건드린다.
    function priceFieldsUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'price', 'shareA', 'shareB', 'splitTotal'
      ]);
    }
    match /venueReservations/{id} {
      allow read: if true;
      allow create: if signedIn()
                    && (inBookingWindow(request.resource.data.date)
                        || isVenueOwner(request.resource.data.venueId)
                        || isAdmin())
                    // 무결제 승인 신뢰모델 보호: 예약자는 "승인 대기(requested)"로만 만들 수 있다.
                    // 승인 완료 상태로 바로 만드는 건 즉시예약 구장(autoApprove)이거나 구장주·어드민일 때뿐.
                    // 이게 없으면 아무나 confirmed 로 예약을 꽂아 승인 절차를 건너뛴다.
                    && (request.resource.data.status == 'requested'
                        || venueAutoApprove(request.resource.data.venueId)
                        || isVenueOwner(request.resource.data.venueId)
                        || isAdmin());
      // 변경 권한: 구장주(승인/거절/완료/노쇼) · 예약자 본인(취소) · 매칭 양 팀장(제휴구장 승인철회) · 어드민.
      //  (기존 "로그인만 하면 누구나 수정" 구멍 제거 — 무결제 승인 신뢰모델 보호. 매칭예약은
      //   teamA/BLeaderUid 로, 앱예약은 userId 로 소유자 식별. 없는 필드는 null → 비교 false)
      allow update: if signedIn()
                    && (isVenueOwner(resource.data.venueId)
                        || request.auth.uid == resource.data.userId
                        || request.auth.uid == resource.data.teamALeaderUid
                        || request.auth.uid == resource.data.teamBLeaderUid
                        || isAdmin())
                    // 날짜만 미래로 옮겨 예약 창구를 우회하는 것도 차단 (날짜 그대로면 허용)
                    && (request.resource.data.date == resource.data.date
                        || inBookingWindow(request.resource.data.date)
                        || isVenueOwner(resource.data.venueId)
                        || isAdmin())
                    // 결제 결과는 서버만 기록 / 결제 마감·금액 정정은 구장주·어드민만
                    && paymentResultUntouched()
                    && (paymentDeadlineUntouched() || isVenueOwner(resource.data.venueId) || isAdmin())
                    && (priceFieldsUntouched() || isVenueOwner(resource.data.venueId) || isAdmin());
      allow delete: if signedIn()
                    && (isVenueOwner(resource.data.venueId)
                        || request.auth.uid == resource.data.userId
                        || isAdmin());
    }
    match /venueBlocks/{id}               { allow read: if true; allow write: if signedIn(); }
    // 슬롯 락 — 코트·날짜별 점유 구간 맵. 이중예약을 막는 트랜잭션이 이 문서를 읽고 쓴다.
    // 예약 자체가 공개 읽기라 여기도 공개(예약 가능 시간 표시에 쓰일 수 있음), 쓰기는 로그인 필수.
    match /venueSlotLocks/{id}            { allow read: if true; allow write: if signedIn(); }
    match /gyms/{id}                      { allow read: if true; allow write: if signedIn(); }

    // ───── 채팅 / 커뮤니티 ─────
    match /chatRooms/{id}                 { allow read: if true; allow write: if signedIn(); }
    match /chatRooms/{id}/{sub=**}        { allow read: if true; allow write: if signedIn(); }
    match /community_posts/{id}           { allow read: if true; allow write: if signedIn(); }
    match /community_posts/{id}/{sub=**}  { allow read: if true; allow write: if signedIn(); }

    // ───── 알림 / 기기 토큰 ─────
    match /notifications/{id}             { allow read: if true;      allow write: if signedIn(); }
    match /fcmTokens/{id}                 { allow read: if signedIn(); allow write: if signedIn(); }

    // ───── 공개 콘텐츠 (읽기 공개 / 쓰기 어드민) ─────
    match /banners/{id}                   { allow read: if true; allow write: if isAdmin(); }
    match /notices/{id}                    { allow read: if true; allow write: if isAdmin(); }
    match /event_popups/{id}              { allow read: if true; allow write: if isAdmin(); }
    match /app_updates/{id}               { allow read: if true; allow write: if isAdmin(); }
    match /legal_documents/{id}           { allow read: if true; allow write: if isAdmin(); }
    match /games/{id}                     { allow read: if true; allow write: if isAdmin(); }

    // ───── 문의 / 신고 / 차단 (비공개 읽기, 로그인 쓰기) ─────
    match /inquiries/{id}                 { allow read: if signedIn(); allow write: if signedIn(); }
    match /community_reports/{id}         { allow read: if signedIn(); allow write: if signedIn(); }
    match /team_reports/{id}              { allow read: if signedIn(); allow write: if signedIn(); }
    match /user_reports/{id}              { allow read: if signedIn(); allow write: if signedIn(); }
    match /user_blocks/{id}               { allow read: if signedIn(); allow write: if signedIn(); }

    // ───── 운영 작업 큐 ─────
    match /tasks/{id}                     { allow read: if true; allow write: if signedIn(); }

    // ───── 어드민 계정 (어드민 전용) ─────
    match /admin_accounts/{id}            { allow read: if isAdmin(); allow write: if isAdmin(); }

    // ───── 개발용 화면 리뷰 스레드 (개발자·AI 협업 · 배포 공유) ─────
    //  /review 개발 도구가 화면별 피드백/기록을 저장하는 컬렉션.
    //  ⚠️ 전면 공개 — 로그인 없이 누구나 읽기·쓰기·삭제 가능. AI 에이전트가 인증 없이
    //     스레드를 읽고 기록하려고 푼 것이다. 리뷰 작업이 끝나면 signedIn()으로 되돌릴 것.
    match /reviewThreads/{id}             { allow read, write: if signedIn(); }

    // ───── 서버(Cloud Functions / Admin SDK) 전용 : 클라 접근 전면 차단 ─────
    match /phone_verifications/{id}       { allow read, write: if false; }
    // 토스 결제 주문 — 금액/결제키가 들어 있어 클라 접근 불필요(결과는 예약 문서로 내려간다)
    match /paymentOrders/{id}             { allow read, write: if false; }
    // 결제 원장 — 금액은 서버 전용(클라가 손대면 정산이 조작된다).
    // 읽기: 정산 대상인 구장주 본인 + 어드민(정산 화면이 전 구장을 집계한다).
    //   구장주 쿼리는 반드시 ownerUid 로 좁혀야 통과한다: where("ownerUid","==",uid)
    // 쓰기: 어드민이 "지급 완료" 체크만 할 수 있다. 금액·결제키·취소 관련 필드는 절대 못 건드린다
    //   — 이 두 필드 외에 하나라도 바뀌면 거부된다. 지급대행이 붙으면 payoutId 는 서버가 채운다.
    match /payments/{id} {
      allow read: if signedIn()
                  && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create, delete: if false;
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(['settled', 'settledAt']);
    }
    match /password_reset_logs/{id}       { allow read, write: if false; }
    match /_system/{id}                   { allow read, write: if false; }

    // ───── 그 외 미열거 컬렉션 : 기본 차단 ─────
    match /{document=**}                  { allow read, write: if false; }
  }
}
